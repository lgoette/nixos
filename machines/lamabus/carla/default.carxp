 <!-- Midi Event Map -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>Midi Event Map</Name>
   <URI>http://gareus.org/oss/lv2/midimap</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x3f1</Options>

   <CustomData>
    <Type>http://kxstudio.sf.net/ns/carla/property</Type>
    <Key>CarlaSkinIsCompacted</Key>
    <Value>true</Value>
   </CustomData>

   <CustomData>
    <Type>http://lv2plug.in/ns/ext/atom#String</Type>
    <Key>http://gareus.org/oss/lv2/midimap#state</Key>
    <Value>
midimap v1
match-all
0xc0/0xff 0x00/0x7f | 0xb0/0x00 0x50/0x00 0x00/0x00
0xc0/0xff 0x01/0x7f | 0xb0/0x00 0x51/0x00 0x7f/0x00
0xc0/0xff 0x02/0x7f | 0xb0/0x00 0x52/0x00 0x7f/0x00
0xc0/0xff 0x03/0x7f | 0xb0/0x00 0x53/0x00 0x7f/0x00

    </Value>
   </CustomData>
  </Data>
 </Plugin>

